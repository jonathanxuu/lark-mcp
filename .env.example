# Legacy single-Bot fallback only. Omit these when every Bot is admin-managed.
# LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
# LARK_APP_SECRET=replace-me
# Dynamic Bot registry. The App Secret is encrypted before it is written here.
LARK_BOT_STORE_PATH=./data/lark-bots.enc.json
LARK_BOT_STORE_KEY=replace-with-a-long-random-key
# Protects /admin/lark-bots. Keep this separate from LARK_BOT_STORE_KEY.
LARK_ADMIN_TOKEN=replace-with-admin-token
# Legacy static multi-Bot registry. Prefer the encrypted admin-managed store
# above for production; never expose app_secret to clients.
# LARK_BOTS_JSON=[{"id":"lark-default","platform":"lark","name":"COUNSO Lark 助手","app_id":"cli_xxx","app_secret":"replace-me","output_folder_token":""}]
LARK_BASE_URL=https://open.larksuite.com
LARK_OAUTH_BASE_URL=https://accounts.larksuite.com
LARK_WEB_BASE_URL=https://www.larksuite.com
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_OAUTH_BASE_URL=https://accounts.feishu.cn
FEISHU_WEB_BASE_URL=https://www.feishu.cn
PORT=4020
# Local: http://localhost:4020
# Production: https://lark-mcp-test.zkid.xyz
PUBLIC_BASE_URL=http://localhost:4020
LARK_OAUTH_REDIRECT_URI=http://localhost:4020/oauth/lark/callback
FEISHU_OAUTH_REDIRECT_URI=http://localhost:4020/oauth/feishu/callback
MCP_OAUTH_ISSUER=http://localhost:4020
MCP_RESOURCE=http://localhost:4020/mcp
LARK_OAUTH_SCOPES=docs:document.content:read wiki:wiki:readonly docs:document.media:download docx:document:create drive:drive
# Optional: a pre-created Lark Drive folder shared with the intended readers.
# New documents are created here when folder_token is not provided to the tool.
LARK_OUTPUT_FOLDER_TOKEN=
FEISHU_OUTPUT_FOLDER_TOKEN=
