LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=replace-me
# Optional multi-Bot registry. When set, these server-side credentials are
# selected by users after OAuth; do not expose app_secret to clients.
# LARK_BOTS_JSON=[{"id":"default","name":"COUNSO Lark 助手","app_id":"cli_xxx","app_secret":"replace-me","output_folder_token":""}]
LARK_BASE_URL=https://open.larksuite.com
PORT=4020
# Local: http://localhost:4020
# Production: https://lark-mcp-test.zkid.xyz
PUBLIC_BASE_URL=http://localhost:4020
LARK_OAUTH_REDIRECT_URI=http://localhost:4020/oauth/lark/callback
MCP_OAUTH_ISSUER=http://localhost:4020
MCP_RESOURCE=http://localhost:4020/mcp
LARK_OAUTH_SCOPES=docs:document.content:read wiki:wiki:readonly docs:document.media:download docx:document:create drive:drive
# Optional: a pre-created Lark Drive folder shared with the intended readers.
# New documents are created here when folder_token is not provided to the tool.
LARK_OUTPUT_FOLDER_TOKEN=
